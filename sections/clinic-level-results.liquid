{% schema %}
{
  "name": "Clinic Level Results",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Add custom class"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clinic-Level Results — Without Breaking the Bank"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>You could easily spend:</p><ul><li>💆‍♀️ $6,000+ on advanced medical-grade treatments</li><li>💉 $1,500+ per syringe for injectable fillers</li><li>🧖‍♀️ $350+ for a single standard facial</li></ul><p>Transform your skin with LED therapy wand — just</p>"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$120"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Right Product Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop the GlowXtra Wand"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Clinic Level Results"
    }
  ]
}
{% endschema %}

<section class="clinic-section {{ section.settings.custom_class }}" style="background-color: {{ section.settings.bg_color }};">
    <div class="container">
  <div class="clinic-wrapper">
    <div class="clinic-left">
      {% if section.settings.left_image %}
        <img src="{{ section.settings.left_image | img_url: 'master' }}" alt="Model image" loading="lazy">
      {% endif %}
    </div>

    <div class="clinic-right">
      <h2 class="clinic-heading">{{ section.settings.heading }}</h2>
      <div class="clinic-subtext">{{ section.settings.subtext }}</div>
      <div class="clinic-price">{{ product.price | money }}</div>

    {% if section.settings.button_label != blank %}
  <a 
    href="#"
    class="btn btn--overlay btn--primary add-to-cart-btn"
  >
    {{ section.settings.button_label }}
  </a>
{% endif %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const customAddBtn = document.querySelector('.add-to-cart-btn');
    
    if (customAddBtn) {
      customAddBtn.addEventListener('click', (e) => {
        e.preventDefault();
        
        // Find the actual Shopify Add to Cart button
        const nativeAddBtn = document.querySelector('.product-form__submit, .product-form__cart-submit, button[name="add"]');
        
        if (nativeAddBtn) {
          nativeAddBtn.click(); // Trigger Shopify's built-in add to cart
        } else {
          console.warn('Native Add to Cart button not found.');
        }
      });
    }
  });
</script>



      <div class="right-image">
      {% if section.settings.product_image %}
        <img class="clinic-product-image" src="{{ section.settings.product_image | img_url: 'master' }}" alt="Product image">
      {% endif %}
      </div>
    </div>
  </div>
  </div>
</section>

<style>
.clinic-section {
  width: 100%;
}
.clinic-section .container {
    max-width: calc(var(--max-width) + calc(var(--space-outer) * 2));
    margin: 0 auto;
    padding: var(--spacing-10) var(--space-outer);
}
.clinic-wrapper {
    display: flex;
    align-items: center;
    gap: 100px;
}

.clinic-left img {
  width: 100%;
  height: auto;
  object-fit: cover;
}
.clinic-wrapper .clinic-left img {
    min-width: 550px;
}
.clinic-right {
    flex: 1 1 50%;
    max-width: 100%;
    position: relative;
}

.clinic-heading {
    line-height: 1.3;
    margin-bottom: 1.2rem;
    font-family: 'Lora';
    font-size: 40px;
}

.clinic-subtext {
  font-size: 1rem;
  line-height: 1.6;
  color: #333;
  margin-bottom: 1.5rem;
}

.clinic-subtext ul {
  list-style: none;
  padding: 0;
  margin: 0 0 1rem;
}

.clinic-subtext li {
  margin-bottom: 0.4rem;
}

.clinic-price {
  font-size: 1.5rem;
  font-weight: 700;
  color: #000;
  margin-bottom: 1.5rem;
}

.clinic-wrapper a.btn.btn--overlay.btn--primary {
    width: 100%;
    max-width: 350px;
    border-radius: 30px;
}
.clinic-right .clinic-subtext p {
    margin-bottom: 20px;
}
.clinic-product-image {
    position: absolute;
    left: 60%;
    bottom: -60px;
    width: 120px;
    height: auto;
}

@media (max-width: 992px) {
  .clinic-wrapper {
    flex-direction: column;
    text-align: center;
    gap: 30px;
}
  .clinic-product-image {
    position: static;
    margin: 30px auto 0;
  }
  .clinic-wrapper .clinic-left img {
    min-width: 100%;
}
.clinic-heading {
    font-size: 26px;
    text-align: left;
}
.clinic-subtext {
    text-align: left;
}
}
</style>
