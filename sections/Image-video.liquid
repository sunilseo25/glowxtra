<section class="video-text-faq-section">
  <div class="container">
    <!-- === Top Section (Video + Text) === -->
    <div class="top-content">
      <div class="video-block">
        {% if section.settings.video != blank %}
          {% if section.settings.video contains "youtube.com" or section.settings.video contains "youtu.be" %}
            <!-- YouTube Embed -->
            <iframe 
              class="custom-video" 
              src="https://www.youtube.com/embed/{{ section.settings.video | split: 'v=' | last | split: '&' | first }}" 
              frameborder="0" 
              allow="autoplay; encrypted-media" 
              allowfullscreen>
            </iframe>

          {% elsif section.settings.video contains "vimeo.com" %}
            <!-- Vimeo Embed -->
            <iframe 
              class="custom-video" 
              src="https://player.vimeo.com/video/{{ section.settings.video | split: '/' | last }}" 
              frameborder="0" 
              allow="autoplay; fullscreen" 
              allowfullscreen>
            </iframe>

          {% else %}
            <!-- Uploaded MP4 Video -->
           {% if section.settings.video != blank %}
  <video 
    class="custom-video" 
    autoplay 
    muted 
    loop 
    playsinline
  >
    {% for source in section.settings.video.sources %}
      {% if source.mime_type == "video/mp4" %}
        <source src="{{ source.url }}" type="video/mp4">
      {% endif %}
    {% endfor %}
    Your browser does not support the video tag.
  </video>
{% endif %}
          {% endif %}
        {% endif %}
      </div>

      <div class="text-block">
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <p>{{ section.settings.text }}</p>
        {% endif %}
        {% if section.settings.small_text != blank %}
         <p class="small_text">{{ section.settings.small_text }}</p>
         {% endif %}
      </div>
    </div>

    <!-- === Bottom Section (Image + FAQ) === -->
    <div class="bottom-content">
      <div class="image-block">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | img_url: '800x' }}" alt="FAQ Image">
        {% endif %}
      </div>

      <div class="faq-block">
        {% if section.settings.faq_heading != blank %}
          <h3>{{ section.settings.faq_heading }}</h3>
        {% endif %}

        <div class="accordion">
          {% for block in section.blocks %}
            <div class="accordion-item">
              <button class="accordion-header">{{ block.settings.question }}</button>
              <div class="accordion-content">
                <p>{{ block.settings.answer }}</p>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <!-- === Styles === -->
  <style>
    .video-text-faq-section .container {
    max-width: calc(var(--max-width) + calc(var(--space-outer) * 2));
    margin: 0 auto;
    padding: var(--spacing-10) var(--space-outer);
}

    .top-content {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 10px;
    flex-direction: row-reverse;
    gap: 50px;
    align-items: center;
}
.top-content .text-block p.small_text {
    padding-top: 50px;
    font-size: 13px;
}
.video-block, .text-block {
      flex: 1;
      min-width: 300px;
}

.custom-video {
    width: 100%;
    object-fit: contain;
}

    .text-block h2 {
    font-size: 46px;
    margin-bottom: 15px;
    text-transform: uppercase;
    max-width: 490px;
    line-height: normal;
    font-family: 'Lora';
}

    .bottom-content {
      display: flex;
      flex-wrap: wrap;
      gap: 50px;
      align-items: center;
    }

    .image-block, .faq-block {
      flex: 1;
    }

   .bottom-content .image-block img {
    width: 100%;
    height: 500px;
    object-fit: cover;
    object-position: top;
}

    .faq-block h3 {
    font-size: 46px;
    font-family: 'Lora';
}
.video-text-faq-section .accordion {
    margin-top: 0;
}
    .accordion-item {
      border-bottom: 1px solid #ddd;
    }

    .accordion-header {
      width: 100%;
      text-align: left;
      padding: 15px 0;
      background: none;
      border: none;
      font-size: 20px;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      font-family: 'Lora';
    }
    .accordion-content p {
    font-size: 15px;
}
    .accordion-header::after {
      content: '+';
      font-weight: bold;
      transition: transform 0.3s;
    }

    .accordion-header.active::after {
      transform: rotate(45deg);
    }

    .accordion-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s ease;
    }

    .accordion-content p {
      padding: 0 0 15px;
    }

    @media (max-width: 768px) {
      .top-content, .bottom-content {
        flex-direction: column;
      }
      .video-block, .text-block {
        min-width: 100%;
      }
      .top-content {
    margin-bottom: 30px;
}
.text-block h2 {
    font-size: 27px;
}
.faq-block h3 {
    font-size: 30px;
}
.bottom-content .image-block img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
}
.custom-video {
    height: 100%;
    max-height: 100%;
    margin-left: 0;
}
.top-content {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 10px;
    flex-direction: row-reverse;
    gap: 50px;
}
.bottom-content {
    gap: 40px;
}
    }
    @media (max-width: 810px){
    .top-content {
    margin-bottom: 30px;
}
    }
    @media (width: 1024px){
    .top-content {
    margin-bottom: 20px;
}
    }
  </style>

  <!-- === Accordion Script === -->
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const accordions = document.querySelectorAll('.accordion-header');
      accordions.forEach(header => {
        header.addEventListener('click', () => {
          const content = header.nextElementSibling;
          header.classList.toggle('active');
          if (content.style.maxHeight) {
            content.style.maxHeight = null;
          } else {
            content.style.maxHeight = content.scrollHeight + 'px';
          }
        });
      });
    });
  </script>
</section>

{% schema %}
{
  "name": "Video+Text+Image+FAQ",
  "settings": [
    { 
      "type": "video", 
      "id": "video", 
      "label": "t:shared.settings.video.label", 
      "info": "t:shared.settings.video.info" 
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fitness for Your Face"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description Text",
      "default": "WHAT IT IS Microcurrent is a low-level current that mimics the body’s natural bioelectric signals..."
    },
    {
      "type": "text",
      "id": "small_text",
      "label": "Add small text here"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "faq_heading",
      "label": "FAQ Heading",
      "default": "FAQs"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video+Text+FAQ",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
