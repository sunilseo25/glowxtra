{% schema %}
{
  "name": "GlowXtra Instructions",
  "settings": [
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Model Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to Use Your GlowXtra Wand"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Simple. Quick. Results you can see."
    },
    {
      "type": "textarea",
      "id": "steps",
      "label": "How‑to Steps (HTML allowed)",
      "default": "<ul>\n<li>🧼 Clean & dry your face.</li>\n<li>💧 Apply your serum (never use on dry skin).</li>\n<li>✨ Turn on the wand and choose Red or Blue Light.</li>\n<li>⭐ Glide slowly along cheeks, forehead, jawline and neck.</li>\n<li>⏱ Use 3–5 minutes daily for best results.</li>\n</ul>"
    },
    {
      "type": "text",
      "id": "badge1_text",
      "label": "Badge 1 Text",
      "default": "Boosts Collagen"
    },
    {
      "type": "text",
      "id": "badge2_text",
      "label": "Badge 2 Text",
      "default": "Reduces Redness"
    },
    {
      "type": "text",
      "id": "badge3_text",
      "label": "Badge 3 Text",
      "default": "Recommended by Dermatologists"
    }
  ],
  "presets": [
    { "name": "GlowXtra Instructions" }
  ]
}
{% endschema %}

<section class="glowxtra-section">
  <div class="gx-container">
    <div class="content-wrapper">
    <div class="gx-left">
      {% if section.settings.main_image != blank %}
        <img src="{{ section.settings.main_image | img_url: '800x' }}" alt="GlowXtra Wand Instructions" class="gx-main-img" />
      {% endif %}
    </div>

    <div class="gx-right">
        <div class="right-content">
      <h2 class="gx-heading">{{ section.settings.heading }}</h2>
      <p class="gx-subheading">{{ section.settings.subheading }}</p>
            </div>
      <div class="gx-steps">
        {{ section.settings.steps }}
      </div>

      <div class="gx-badges">
        <div class="gx-badge">{{ section.settings.badge1_text }}</div>
        <div class="gx-badge">{{ section.settings.badge2_text }}</div>
        <div class="gx-badge">{{ section.settings.badge3_text }}</div>
      </div>
      </div>
    </div>
  </div>
</section>

<style>
.glowxtra-section {
  padding: 60px 0;
  background: #f7f5f2;
}

.gx-container {
    max-width: calc(var(--max-width) + calc(var(--space-outer) * 2));
    margin: 0 auto;
    padding: var(--spacing-10) var(--space-outer);
}

.gx-left { flex: 1; }
.gx-right { flex: 1.2; }

.gx-main-img {
  width: 100%;
  height: auto;
  border-radius: 12px;
}

.gx-heading {
  font-size: 34px;
  font-weight: 700;
  margin-bottom: 10px;
}

.gx-subheading {
  font-style: italic;
  margin-bottom: 20px;
  color: #444;
}

.gx-steps ul {
  padding-left: 20px;
  margin-bottom: 30px;
}

.gx-badges {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

.gx-badge {
  background: #000;
  color: #fff;
  padding: 12px 20px;
  border-radius: 50%;
  text-align: center;
  font-size: 14px;
  min-width: 120px;
  min-height: 120px;
  display: flex;
  justify-content: center;
  align-items: center;
  text-transform: uppercase;
  border: 2px solid #000;
}

@media(max-width: 768px){
  .gx-container { flex-direction: column; text-align: center; }
  .gx-badges { justify-content: center; }
}
</style>
