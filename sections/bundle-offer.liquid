<style>
.bundle-offer-section {
  padding: 50px 0;
  text-align: center;
}

.bundle-top-text {
  font-size: 18px;
  letter-spacing: 1px;
  color: #000;
  margin-bottom: 10px;
}

.bundle-main-heading {
  font-size: 32px;
  font-weight: bold;
  margin-bottom: 5px;
}

.bundle-subheading {
  font-size: 20px;
  margin-bottom: 20px;
  color: #333;
}

.bundle-discount-box {
  background: #4c7f34;
  color: #fff;
  padding: 12px 24px;
  font-size: 18px;
  display: inline-block;
  border-radius: 6px;
  margin-bottom: 30px;
}

.bundle-products-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 20px;
}

.bundle-product-card {
  background: #fff;
  padding: 10px;
}

.bundle-img {
  width: 100%;
  display: block;
  border-radius: 6px;
}

@media(max-width: 768px) {
  .bundle-products-grid {
    grid-template-columns: 1fr;
  }
  .bundle-main-heading {
    font-size: 26px;
  }
}
</style>

<section class="bundle-offer-section">
  <div class="bundle-offer-wrapper">

    <!-- Heading -->
    <div class="bundle-offer-header">
      {% if section.settings.top_text != blank %}
        <p class="bundle-top-text">{{ section.settings.top_text }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="bundle-main-heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="bundle-subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      {% if section.settings.discount_text != blank %}
        <div class="bundle-discount-box">
          <span>{{ section.settings.discount_text }}</span>
        </div>
      {% endif %}
    </div>

    <!-- Product Cards -->
    <div class="bundle-products-grid">
      {% for block in section.blocks %}
        <div class="bundle-product-card">

          {% if block.settings.product_image_1 != blank %}
            <img class="bundle-img" src="{{ block.settings.product_image_1 | img_url: '600x' }}" alt="Product Image 1">
          {% endif %}

          {% if block.settings.product_image_2 != blank %}
            <img class="bundle-img" src="{{ block.settings.product_image_2 | img_url: '600x' }}" alt="Product Image 2">
          {% endif %}

        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Bundle Offer Section",
  "settings": [
    {
      "type": "text",
      "id": "top_text",
      "label": "Top Text",
      "default": "BUNDLE & SAVE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BLACK FRIDAY"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Microcurrent Roller + 24K Gold Serums"
    },
    {
      "type": "text",
      "id": "discount_text",
      "label": "Discount Text",
      "default": "UP TO 40% OFF"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "product_image_1",
          "label": "Product Image 1"
        },
        {
          "type": "image_picker",
          "id": "product_image_2",
          "label": "Product Image 2"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Bundle Offer Section"
    }
  ]
}
{% endschema %}
