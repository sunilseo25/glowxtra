<style>
.shop-look {
  text-align: center;
  background-color: {{ section.settings.bg-color }};
}

.shop-look__title {
  letter-spacing: 1px;
  font-weight: 600;
  margin-bottom: 30px;
  font-family: 'Lora';
}

.shop-look .container {
  max-width: calc(var(--max-width) + calc(var(--space-outer) * 2));
  margin: 0 auto;
  padding: var(--spacing-10) var(--space-outer);
}

/* ---------- Desktop Layout ---------- */
.shop-look__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}

.shop-look__item {
  position: relative;
  overflow: hidden;
}

.shop-look__item img {
  width: 100%;
  transition: transform 0.3s ease;
}

/* Hover button */
.shop-look__btn {
  position: absolute;
  bottom: 15px;
  left: 25%;
  transform: translateX(-50%);
  background: #dda6b2;
  padding: 10px 20px;
  font-size: 0.8rem;
  color: #fff;
  text-decoration: none;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.shop-look__item:hover .shop-look__btn {
  opacity: 1;
}

/* ---------- Mobile Slider Layout ---------- */
@media screen and (max-width: 768px) {
  .shop-look__grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 12px;
    padding-bottom: 10px;
    -webkit-overflow-scrolling: touch;
  }

  .shop-look__item {
    flex: 0 0 80%; /* Each slide takes 80% width */
    scroll-snap-align: start;
  }

  .shop-look__item img {
    width: 100%;
    height: 100%;
  }
  .shop-look__btn {
    bottom: 11px;
    left: 29%;
    background: #dda6b2;
    padding: 10px 18px;
    color: #fff;
}
  /* Hide scrollbar for a clean look */
  .shop-look__grid::-webkit-scrollbar {
    display: none;
  }
  .shop-look__grid {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Optional: small indicator arrow */
  .shop-look__grid::after {
    content: "→";
    position: absolute;
    right: 15px;
    bottom: 10px;
    color: #888;
    font-size: 1.2rem;
  }
}
</style>

<section class="shop-look">
  <div class="container">
    <h2 class="shop-look__title">{{ section.settings.title }}</h2>

    <div class="shop-look__grid">
      {% for block in section.blocks %}
        <div class="shop-look__item">
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | img_url: '600x' }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
            >
          {% endif %}

          {% if block.settings.button_link != blank %}
            <a href="{{ block.settings.button_link }}" class="shop-look__btn">
              {{ block.settings.button_text }}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop The Look",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "SHOP THE LOOK"
    },
    {
        "type": "color",
        "id": "bg-color",
        "label": "Add bacground here"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Look Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Look image"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "VIEW PRODUCT"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Shop The Look",
      "category": "Image"
    }
  ]
}
{% endschema %}
